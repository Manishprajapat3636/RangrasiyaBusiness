@model RangrasiyaBusiness.Models.QuotationCondition

@{
    ViewData["Title"] = "Condition Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Condition Details</h2>

            <p class="text-muted mb-0">
                View quotation condition details.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-quotationId="@Model.QuotationId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Conditions

        </a>

    </div>


    <!-- Quotation Information -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="text-muted small">
                        QUOTATION NUMBER
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Quotation?.QuotationNumber
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        CUSTOMER
                    </div>

                    <div class="fw-bold fs-5">
                        @(Model.Quotation?.Customer?.CustomerName ?? "-")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        CONDITION ID
                    </div>

                    <div class="fw-bold fs-5">
                        #@Model.QuotationConditionId
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Condition -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">
                Condition
            </h5>

        </div>

        <div class="card-body">

            <div class="p-4 bg-light rounded"
                 style="white-space: pre-wrap; line-height: 1.7;">

                @Model.ConditionText

            </div>


            <div class="d-flex gap-2 mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.QuotationConditionId"
                   class="btn btn-primary px-4">

                    <i class="bi bi-pencil"></i>
                    Edit

                </a>


                <a asp-action="Delete"
                   asp-route-id="@Model.QuotationConditionId"
                   class="btn btn-outline-danger px-4">

                    <i class="bi bi-trash"></i>
                    Delete

                </a>

            </div>

        </div>

    </div>

</div>