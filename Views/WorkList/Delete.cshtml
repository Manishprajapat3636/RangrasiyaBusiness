
@model RangrasiyaBusiness.Models.WorkList

@{
    ViewData["Title"] = "Delete Work List";
}

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">WORK MANAGEMENT</div>
            <h2>Delete Work List</h2>
            <p>Review the record before confirming deletion.</p>
        </div>

        <a asp-action="Index" class="modern-clear-btn">← Back</a>
    </div>

    <div class="modern-panel customer-form-card">

        <div class="form-section-title">
            <h4>Confirm Deletion</h4>
            <p>
                Are you sure you want to delete this Work List?
                Its associated measurement rows will also be deleted.
            </p>
        </div>

        <div class="form-grid">

            <div class="form-group">
                <label>Work Order No.</label>
                <div class="modern-form-input">@Model.WorkOrderNo</div>
            </div>

            <div class="form-group">
                <label>Quotation No.</label>
                <div class="modern-form-input">@Model.QuotationNo</div>
            </div>

            <div class="form-group">
                <label>Bill No.</label>
                <div class="modern-form-input">@Model.BillNo</div>
            </div>

            <div class="form-group">
                <label>Customer</label>
                <div class="modern-form-input">
                    @(Model.Customer?.CustomerName ?? "-")
                </div>
            </div>

        </div>

        <form asp-action="Delete"
              asp-route-id="@Model.WorkListId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.WorkListId" />

            <div class="form-actions">

                <button type="submit"
                        class="modern-primary-btn"
                        style="background:#dc3545;">
                    Yes, Delete Work List
                </button>

                <a asp-action="Index"
                   class="modern-secondary-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
