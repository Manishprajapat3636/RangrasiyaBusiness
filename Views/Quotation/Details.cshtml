
@model RangrasiyaBusiness.Models.Quotation

@{
    ViewData["Title"] = "Quotation Details";
}

<div class="details-page">

    <!-- Page Header -->
    <div class="details-topbar">
        <div>
            <span class="page-eyebrow">QUOTATION MANAGEMENT</span>
            <h1>Quotation Details</h1>
            <p>View complete quotation information.</p>
        </div>

        <div class="details-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.QuotationId"
               class="btn btn-outline-primary">
                ✏️ Edit
            </a>

            <a asp-action="DownloadPdf"
               asp-route-id="@Model.QuotationId"
               class="btn btn-primary">
                📄 Download PDF
            </a>

            <button onclick="window.print()"
                    class="btn btn-outline-secondary">
                🖨️ Print
            </button>
        </div>
    </div>

    <!-- Quotation Document -->
    <div class="quotation-document">

        <!-- Company Header -->
        <div class="company-header">

            <div class="company-logo">
                <img src="~/images/logo.png"
                     alt="Company Logo" />
            </div>

            <div class="company-info">
                <h2>RANGRASIYA MARKETING</h2>
                <h4>ADVERTISING AND PAINTING WORKS</h4>

                <p>
                    37 Prithviraj Nagar, Durgapura, Jaipur,
                    Rajasthan - 302018
                </p>

                <p>
                    <strong>Mobile:</strong> 9653935955
                    &nbsp; | &nbsp;
                    <strong>Email:</strong> rangrasiya4723@gmail.com
                </p>

                <p>
                    <strong>GSTIN:</strong> 08EPBPP4105P1ZJ
                </p>
            </div>

        </div>

        <!-- Title -->
        <div class="quotation-title">
            <h2>QUOTATION</h2>
            <span class="status-badge">@Model.Status</span>
        </div>

        <!-- Basic Details -->
        <div class="info-grid">

            <div class="info-box">
                <span>Quotation Number</span>
                <strong>@Model.QuotationNumber</strong>
            </div>

            <div class="info-box">
                <span>Quotation Date</span>
                <strong>
                    @Model.QuotationDate.ToString("dd-MM-yyyy")
                </strong>
            </div>

            <div class="info-box">
                <span>Validity</span>
                <strong>@Model.QuotationValidity</strong>
            </div>

            <div class="info-box">
                <span>Work Order Number</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.WorkOrderNo)
                        ? "-"
                        : Model.WorkOrderNo)
                </strong>
            </div>

            <div class="info-box full-width">
                <span>Place of Work</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.PlaceOfWork)
                        ? "-"
                        : Model.PlaceOfWork)
                </strong>
            </div>

        </div>

        <!-- Customer Details -->
        <div class="section-heading">
            <h3>Customer Details</h3>
        </div>

        <div class="customer-box">

            <div>
                <span>Company Name</span>
                <strong>@Model.Customer?.CustomerName</strong>
            </div>

            <div>
                <span>Contact Person</span>
                <strong>
                    @(Model.Customer?.ContactPerson ?? "-")
                </strong>
            </div>

            <div>
                <span>Phone</span>
                <strong>
                    @(Model.Customer?.Phone ?? "-")
                </strong>
            </div>

            <div>
                <span>GSTIN</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Customer?.GSTIN)
                        ? "-"
                        : Model.Customer.GSTIN)
                </strong>
            </div>

            <div class="full-width">
                <span>Address</span>
                <strong>
                    @(Model.Customer?.Address ?? "-")
                </strong>
            </div>

        </div>

        <!-- Items -->
        <div class="section-heading">
            <h3>Quotation Items</h3>
        </div>

        <div class="table-wrapper">
            <table class="quotation-table">

                <thead>
                    <tr>
                        <th>Sr.</th>
                        <th>Item / Service</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Rate</th>
                        <th>GST %</th>
                        <th>Amount</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int sr = 1;
                    }

                    @foreach (var item in Model.QuotationItems)
                    {
                        <tr>
                            <td>@sr</td>

                            <td>
                                <strong>
                                    @(item.ItemNameSnapshot ?? item.Item?.ItemName ?? "-")
                                </strong>
                            </td>

                            <td>@item.Quantity</td>

                            <td>@item.Unit</td>

                            <td>₹ @item.Rate.ToString("N2")</td>

                            <td>@item.GSTPercentage%</td>

                            <td>₹ @item.Amount.ToString("N2")</td>

                            <td>
                                <strong>
                                    ₹ @item.TotalAmount.ToString("N2")
                                </strong>
                            </td>
                        </tr>

                        sr++;
                    }
                </tbody>

            </table>
        </div>

        <!-- Totals -->
        <div class="totals-section">

            <div class="total-row">
                <span>Subtotal</span>
                <strong>₹ @Model.SubTotal.ToString("N2")</strong>
            </div>

            <div class="total-row">
                <span>GST Amount</span>
                <strong>₹ @Model.GSTAmount.ToString("N2")</strong>
            </div>

            <div class="grand-total">
                <span>Grand Total</span>
                <strong>₹ @Model.GrandTotal.ToString("N2")</strong>
            </div>

        </div>

        <!-- Signature -->
        <div class="signature-section">

            <p>
                <strong>For Rangrasiya Marketing,</strong><br />
                <strong>Advertising and Painting Works</strong>
            </p>

            <br />
            <br />

            ______________________________

            <p>
                <strong>Authorised Signatory</strong>
            </p>

        </div>

    </div>

    <!-- Bottom Buttons -->
    <div class="bottom-actions">

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to Quotations
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.QuotationId"
           class="btn btn-outline-danger">
            🗑️ Delete
        </a>

    </div>

</div>

<style>

    .details-page {
        padding: 30px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .details-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-eyebrow {
        color: #1769e0;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .details-topbar h1 {
        margin: 6px 0;
        font-size: 30px;
        font-weight: 750;
        color: #172b4d;
    }

    .details-topbar p {
        margin: 0;
        color: #718096;
    }

    .details-actions,
    .bottom-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .quotation-document {
        background: #ffffff;
        border: 1px solid #e4eaf2;
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(30, 55, 90, 0.07);
    }

    .company-header {
        display: flex;
        align-items: center;
        gap: 25px;
        padding-bottom: 25px;
        border-bottom: 2px solid #1769e0;
    }

    .company-logo {
        width: 170px;
        flex-shrink: 0;
    }

    .company-logo img {
        width: 100%;
        max-height: 130px;
        object-fit: contain;
    }

    .company-info {
        flex: 1;
        text-align: center;
    }

    .company-info h2 {
        margin: 0;
        color: #1769e0;
        font-size: 25px;
        font-weight: 800;
    }

    .company-info h4 {
        margin: 5px 0 12px;
        color: #334155;
        font-size: 14px;
    }

    .company-info p {
        margin: 5px 0;
        color: #64748b;
        font-size: 13px;
    }

    .quotation-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1769e0;
        color: white;
        padding: 14px 20px;
        margin: 25px 0;
        border-radius: 10px;
    }

    .quotation-title h2 {
        margin: 0;
        font-size: 22px;
        letter-spacing: 1px;
    }

    .status-badge {
        background: white;
        color: #1769e0;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 700;
    }

    .info-grid,
    .customer-box {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .info-box,
    .customer-box > div {
        background: #f8faff;
        border: 1px solid #e5ebf5;
        border-radius: 10px;
        padding: 15px;
    }

    .info-box span,
    .customer-box span {
        display: block;
        color: #718096;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .info-box strong,
    .customer-box strong {
        color: #243b53;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .section-heading {
        margin: 30px 0 15px;
        border-bottom: 1px solid #e5eaf2;
        padding-bottom: 10px;
    }

    .section-heading h3 {
        margin: 0;
        color: #243b53;
        font-size: 19px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .quotation-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

    .quotation-table th {
        background: #1769e0;
        color: white;
        padding: 13px 10px;
        text-align: left;
        font-size: 12px;
        white-space: nowrap;
    }

    .quotation-table td {
        padding: 13px 10px;
        border-bottom: 1px solid #e5eaf2;
        color: #475569;
        font-size: 13px;
    }

    .quotation-table tbody tr:nth-child(even) {
        background: #f8faff;
    }

    .totals-section {
        max-width: 400px;
        margin: 30px 0 0 auto;
        border: 1px solid #e3eaf4;
        border-radius: 12px;
        padding: 18px;
    }

    .total-row,
    .grand-total {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        color: #64748b;
    }

    .grand-total {
        margin-top: 8px;
        padding-top: 15px;
        border-top: 2px solid #1769e0;
        color: #1769e0;
        font-size: 19px;
        font-weight: 800;
    }

    .signature-section {
        text-align: right;
        margin-top: 45px;
        color: #334155;
        page-break-inside: avoid;
    }

    .bottom-actions {
        margin-top: 20px;
        justify-content: space-between;
    }

    @@media (max-width: 768px) {

        .details-page {
            padding: 15px;
        }

        .details-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .quotation-document {
            padding: 20px;
        }

        .company-header {
            flex-direction: column;
        }

        .company-logo {
            width: 140px;
        }

        .info-grid,
        .customer-box {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .totals-section {
            max-width: 100%;
        }

    }

    @@media print {

        .details-topbar,
        .bottom-actions,
        .details-actions,
        nav,
        footer {
            display: none !important;
        }

        .details-page {
            padding: 0;
            background: white;
        }

        .quotation-document {
            border: none;
            box-shadow: none;
            padding: 0;
        }

        body {
            background: white !important;
        }

    }

</style>
