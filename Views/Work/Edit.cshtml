
@model RangrasiyaBusiness.Models.Work

@{
    ViewData["Title"] = "Edit Work";
}

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">WORKS & PROJECTS</div>
            <h2>Edit Work</h2>
            <p>Update project information and amounts</p>
        </div>

        <a asp-action="Index" class="modern-clear-btn">← Back</a>
    </div>

    <div class="modern-panel customer-form-card">

        <div class="form-section-title">
            <h4>Project Information</h4>
            <p>Update the work details below</p>
        </div>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="WorkId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="WorkName">Work Name *</label>
                    <input asp-for="WorkName" class="modern-form-input" />
                    <span asp-validation-for="WorkName"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CustomerId">Customer</label>
                    <select asp-for="CustomerId"
                            class="modern-form-input"
                            asp-items="ViewBag.CustomerId">
                        <option value="0">-- Select Customer --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="StartDate">Start Date</label>
                    <input asp-for="StartDate"
                           type="datetime-local"
                           class="modern-form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="EndDate">End Date</label>
                    <input asp-for="EndDate"
                           type="datetime-local"
                           class="modern-form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status" class="modern-form-input">
                        <option value="Proposed">Proposed</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="WorkLocation">Work Location</label>
                    <input asp-for="WorkLocation"
                           class="modern-form-input" />
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description"
                              class="modern-form-input"
                              rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="EstimatedAmount">Estimated Amount (₹)</label>
                    <input asp-for="EstimatedAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="modern-form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="ActualAmount">Actual Amount (₹)</label>
                    <input asp-for="ActualAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="modern-form-input" />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="modern-primary-btn">
                    Update Work
                </button>

                <a asp-action="Index" class="modern-secondary-btn">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
