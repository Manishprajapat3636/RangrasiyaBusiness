
@model RangrasiyaBusiness.Models.Item

@{
    ViewData["Title"] = "Add Item";
}

<style>
    .customer-form-page { max-width: 1200px; margin: 0 auto; padding: 22px; }
    .customer-form-page, .customer-form-page * { box-sizing: border-box; }
    .customer-form-page .page-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px; }
    .customer-form-page .customer-form-card { padding:clamp(18px, 3vw, 32px); }
    .customer-form-page .form-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:20px; }
    .customer-form-page .form-group { min-width:0; }
    .customer-form-page .form-group label { display:block; margin-bottom:8px; font-weight:700; color:#244366; }
    .customer-form-page .modern-form-input { width:100%; max-width:100%; min-width:0; border:1px solid #d5dfec; border-radius:9px; padding:11px 12px; background:#fff; }
    .customer-form-page .modern-form-input:focus { border-color:#4389ed; outline:3px solid #dceaff; }
    .customer-form-page textarea.modern-form-input { min-height:68px; resize:vertical; overflow-wrap:anywhere; }
    .customer-form-page .form-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
    .customer-form-page .modern-primary-btn, .customer-form-page .modern-secondary-btn, .customer-form-page .modern-clear-btn { border:1px solid transparent; border-radius:9px; padding:10px 16px; font-weight:700; text-decoration:none; cursor:pointer; }
    .customer-form-page .modern-primary-btn { background:#1769e0; color:#fff; border-color:#1769e0; }
    .customer-form-page .modern-secondary-btn, .customer-form-page .modern-clear-btn { background:#fff; color:#24517f; border-color:#d5dfec; }
    .customer-form-page .modern-primary-btn:hover { background:#0d55bd; }
    .customer-form-page .modern-secondary-btn:hover, .customer-form-page .modern-clear-btn:hover { background:#f3f7fc; }
    @@media (max-width: 640px) {
        .customer-form-page { padding:12px; }
        .customer-form-page .form-grid { grid-template-columns:minmax(0, 1fr); gap:15px; }
        .customer-form-page .page-heading { align-items:flex-start; }
        .customer-form-page .form-actions > * { flex:1 1 auto; text-align:center; }
    }
</style>

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">ITEMS & SERVICES</div>
            <h2>Add Item / Service</h2>
            <p>Create a new item or service with pricing</p>
        </div>

        <a asp-action="Index" class="modern-clear-btn">← Back</a>
    </div>

    <div class="modern-panel customer-form-card">

        <div class="form-section-title">
            <h4>Item Information</h4>
            <p>Enter item details, unit and tax information</p>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="ItemName">Item Name *</label>
                    <textarea asp-for="ItemName"
                              class="modern-form-input"
                              rows="2"
                              maxlength="500"
                              placeholder="Enter item or service name or a longer description"></textarea>
                    <span asp-validation-for="ItemName"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Category">Category</label>
                    <input asp-for="Category"
                           class="modern-form-input"
                           placeholder="Painting, Advertising..." />
                </div>

                <div class="form-group">
                    <label asp-for="Unit">Unit</label>
                    <select asp-for="Unit" class="modern-form-input">
                        <option value="">-- Select Unit --</option>
                        <option value="Sq Ft">Sq Ft</option>
                        <option value="Sq M">Sq M</option>
                        <option value="Sq INCH">Sq INCH</option>
                        <option value="Piece">Piece</option>
                        <option value="Hour">Hour</option>
                        <option value="Day">Day</option>
                        <option value="Job">Job</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Rate">Rate (₹)</label>
                    <input asp-for="Rate"
                           type="number"
                           step="0.01"
                           min="0"
                           class="modern-form-input"
                           placeholder="0.00" />
                </div>

                <div class="form-group">
                    <label asp-for="GSTPercentage">GST Percentage (%)</label>
                    <input asp-for="GSTPercentage"
                           type="number"
                           step="0.01"
                           min="0"
                           max="100"
                           class="modern-form-input"
                           placeholder="18" />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="modern-primary-btn">
                    Save Item
                </button>

                <a asp-action="Index" class="modern-secondary-btn">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
