@model RangrasiyaBusiness.Models.Work

@{
    ViewData["Title"] = "Create Work";
}

<div class="customer-form-page">

    <div class="page-heading">

        <div>
            <div class="page-eyebrow">WORKS & PROJECTS</div>

            <h2>Create New Work</h2>

            <p>Add a new project and financial details</p>
        </div>

        <a asp-action="Index"
           class="modern-clear-btn">
            ← Back
        </a>

    </div>


    <div class="modern-panel customer-form-card">

        <div class="form-section-title">

            <h4>Project Information</h4>

            <p>
                Enter the basic details of your work
            </p>

        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="form-grid">


                <!-- Work Name -->

                <div class="form-group">

                    <label asp-for="WorkName">
                        Work Name *
                    </label>

                    <input asp-for="WorkName"
                           class="modern-form-input"
                           placeholder="Enter work name" />

                    <span asp-validation-for="WorkName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Customer -->

                <div class="form-group">

                    <label asp-for="CustomerId">
                        Customer
                    </label>

                    <select asp-for="CustomerId"
                            class="modern-form-input"
                            asp-items="ViewBag.CustomerId">

                        <option value="0">
                            -- Select Customer --
                        </option>

                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Start Date -->

                <div class="form-group">

                    <label asp-for="StartDate">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="datetime-local"
                           class="modern-form-input" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- End Date -->

                <div class="form-group">

                    <label asp-for="EndDate">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="datetime-local"
                           class="modern-form-input" />

                    <span asp-validation-for="EndDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Status -->

                <div class="form-group">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="modern-form-input">

                        <option value="Proposed">
                            Proposed
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                    </select>

                </div>


                <!-- Work Location -->

                <div class="form-group">

                    <label asp-for="WorkLocation">
                        Work Location
                    </label>

                    <input asp-for="WorkLocation"
                           class="modern-form-input"
                           placeholder="Enter work location" />

                </div>


                <!-- Description -->

                <div class="form-group full-width">

                    <label asp-for="Description">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="modern-form-input"
                              rows="3"
                              placeholder="Enter project description">
                    </textarea>

                </div>


                <!-- Estimated Amount -->

                <div class="form-group">

                    <label asp-for="EstimatedAmount">
                        Estimated Amount (₹)
                    </label>

                    <input asp-for="EstimatedAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="modern-form-input"
                           placeholder="0.00" />

                </div>


                <!-- Actual Amount -->

                <div class="form-group">

                    <label asp-for="ActualAmount">
                        Actual Amount (₹)
                    </label>

                    <input asp-for="ActualAmount"
                           type="number"
                           step="0.01"
                           min="0"
                           class="modern-form-input"
                           placeholder="0.00" />

                </div>


            </div>


            <!-- Actions -->

            <div class="form-actions">

                <button type="submit"
                        class="modern-primary-btn">

                    Save Work

                </button>


                <a asp-action="Index"
                   class="modern-secondary-btn">

                    Cancel

                </a>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}