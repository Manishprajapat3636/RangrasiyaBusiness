@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Register - RANGRASIYA</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: linear-gradient(135deg, #edf4ff, #f8fbff);
            color: #172b4d;
        }

        .register-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 18px;
        }

        .register-card {
            width: 100%;
            max-width: 480px;
            background: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 20px 60px rgba(27,64,110,.12);
        }

        .brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .logo {
            width: 65px;
            height: 65px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: #eaf2ff;
            color: #176bd1;
            font-size: 36px;
            font-weight: 800;
        }

        h2 {
            margin: 0;
            color: #102c55;
            font-size: 29px;
        }

        .subtitle {
            color: #8190a6;
            font-size: 14px;
            margin-top: 10px;
        }

        .validation {
            color: #dc3545;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #526581;
        }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #dce5f1;
            border-radius: 12px;
            outline: none;
            font-size: 14px;
            background: #fbfdff;
            transition: .25s;
        }

        .form-control:focus {
            border-color: #176bd1;
            box-shadow: 0 0 0 4px rgba(23,107,209,.1);
        }

        .register-button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 12px;
            color: white;
            background: linear-gradient(90deg, #176bd1, #2499f3);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: .25s;
        }

        .register-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(23,107,209,.25);
        }

        .login-link {
            text-align: center;
            margin-top: 25px;
            color: #8190a6;
            font-size: 14px;
        }

        .login-link a {
            color: #176bd1;
            text-decoration: none;
            font-weight: 600;
        }

        .terms {
            text-align: center;
            color: #9aa7b8;
            font-size: 11px;
            margin-top: 22px;
            line-height: 1.6;
        }

        @@media (max-width: 480px) {
            .register-card {
                padding: 28px 22px;
            }
        }
    </style>

</head>

<body>

    <div class="register-page">

        <div class="register-card">

            <div class="brand">

                <div class="logo">R</div>

                <h2>Create Account</h2>

                <p class="subtitle">
                    Start managing your business with RANGRASIYA
                </p>

            </div>

            <div class="validation">
                @Html.ValidationSummary()
            </div>

            <form asp-action="Register" method="post">

                <div class="form-group">

                    <label>Full Name</label>

                    <input type="text"
                           name="fullName"
                           class="form-control"
                           placeholder="Enter your full name"
                           required />

                </div>

                <div class="form-group">

                    <label>Email Address</label>

                    <input type="email"
                           name="email"
                           class="form-control"
                           placeholder="Enter your email"
                           required />

                </div>

                <div class="form-group">

                    <label>Password</label>

                    <input type="password"
                           name="password"
                           class="form-control"
                           placeholder="Create a strong password"
                           required />

                </div>

                <button type="submit" class="register-button">
                    Create Account →
                </button>

            </form>

            <div class="login-link">

                Already have an account?
                <a asp-action="Login">Login Now</a>

            </div>

            <div class="terms">
                Your account is used to access the RANGRASIYA
                Business Management System.
            </div>

        </div>

    </div>

</body>
</html>
