@model RangrasiyaBusiness.Models.QuotationCondition

@{
    ViewData["Title"] = "Delete Condition";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Delete Condition
        </h2>

        <p class="text-muted mb-0">
            Confirm that you want to delete this condition.
        </p>

    </div>


    <!-- Warning -->

    <div class="alert alert-danger border-0 shadow-sm">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        <strong>Warning:</strong>
        This condition will be permanently deleted.

    </div>


    <!-- Condition Information -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-4 mb-4">

                <div class="col-md-6">

                    <div class="text-muted small">
                        QUOTATION NUMBER
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Quotation?.QuotationNumber
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        CUSTOMER
                    </div>

                    <div class="fw-bold fs-5">
                        @(Model.Quotation?.Customer?.CustomerName ?? "-")
                    </div>

                </div>

            </div>


            <div class="border-top pt-4">

                <div class="text-muted small mb-2">
                    CONDITION
                </div>

                <div class="p-3 bg-light rounded"
                     style="white-space: pre-wrap; line-height: 1.7;">

                    @Model.ConditionText

                </div>

            </div>

        </div>

    </div>


    <!-- Delete Form -->

    <form asp-action="DeleteConfirmed"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.QuotationConditionId" />


        <button type="submit"
                class="btn btn-danger px-4">

            <i class="bi bi-trash"></i>
            Yes, Delete Condition

        </button>


        <a asp-action="Index"
           asp-route-quotationId="@Model.QuotationId"
           class="btn btn-outline-secondary px-4 ms-2">

            Cancel

        </a>

    </form>

</div>