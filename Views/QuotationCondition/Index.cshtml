@model IEnumerable<RangrasiyaBusiness.Models.QuotationCondition>

@{
    ViewData["Title"] = "Quotation Conditions";
    var quotation = ViewBag.Quotation as RangrasiyaBusiness.Models.Quotation;
    var conditionCount = Model.Count();
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Quotation Conditions
            </h2>

            <p class="text-muted mb-0">
                Manage individual terms and conditions for this quotation.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-quotationId="@quotation.QuotationId"
           class="btn btn-primary px-4">

            <i class="bi bi-plus-lg"></i>
            Add Condition

        </a>

    </div>


    <!-- Quotation Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="text-muted small">
                        QUOTATION NUMBER
                    </div>

                    <div class="fw-bold fs-5">
                        @quotation.QuotationNumber
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        CUSTOMER
                    </div>

                    <div class="fw-bold fs-5">
                        @(quotation.Customer?.CustomerName ?? "-")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        CONDITIONS ADDED
                    </div>

                    <div class="fw-bold fs-5">
                        @conditionCount
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Conditions -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Conditions
                </h5>

                <span class="badge bg-primary">
                    @conditionCount
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:80px;">
                                    #
                                </th>

                                <th>
                                    Condition
                                </th>

                                <th class="text-end" style="width:180px;">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int serialNumber = 1;
                            }

                            @foreach (var condition in Model)
                            {
                                <tr>

                                    <td class="fw-bold text-muted">
                                        @serialNumber
                                    </td>


                                    <td>

                                        <div style="white-space: pre-wrap;">
                                            @condition.ConditionText
                                        </div>

                                    </td>


                                    <td class="text-end">

    <!-- Details -->
    <a asp-action="Details"
       asp-route-id="@condition.QuotationConditionId"
       class="btn btn-sm btn-outline-secondary me-1">

        <i class="bi bi-eye"></i>
        Details

    </a>


    <!-- Edit -->
    <a asp-action="Edit"
       asp-route-id="@condition.QuotationConditionId"
       class="btn btn-sm btn-outline-primary me-1">

        <i class="bi bi-pencil"></i>
        Edit

    </a>


    <!-- Delete -->
    <a asp-action="Delete"
       asp-route-id="@condition.QuotationConditionId"
       class="btn btn-sm btn-outline-danger">

        <i class="bi bi-trash"></i>
        Delete

    </a>

</td>
                                </tr>

                                serialNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-file-text"
                           style="font-size:48px; color:#adb5bd;"></i>

                    </div>

                    <h5 class="fw-bold">
                        No conditions added
                    </h5>

                    <p class="text-muted mb-4">
                        Add your first condition for this quotation.
                    </p>

                    <a asp-action="Create"
                       asp-route-quotationId="@quotation.QuotationId"
                       class="btn btn-primary px-4">

                        <i class="bi bi-plus-lg"></i>
                        Add First Condition

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- Back -->
    <div class="mt-4">

        <a asp-controller="Quotation" 
           asp-action="Details"
           asp-route-id="@quotation.QuotationId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Quotation

        </a>

    </div>

</div>
