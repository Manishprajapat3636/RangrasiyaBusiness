
@model RangrasiyaBusiness.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">CUSTOMERS</div>
            <h2>Edit Customer</h2>
            <p>Update customer information</p>
        </div>

        <a asp-action="Index" class="modern-clear-btn">← Back</a>
    </div>

    <div class="modern-panel customer-form-card">

        <div class="form-section-title">
            <h4>Customer Information</h4>
            <p>Modify the customer details below</p>
        </div>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="CustomerId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="CustomerName">Company Name *</label>
                    <input asp-for="CustomerName"
                           class="modern-form-input"
                           placeholder="Enter company name" />
                    <span asp-validation-for="CustomerName"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ContactPerson">Contact Person</label>
                    <input asp-for="ContactPerson"
                           class="modern-form-input"
                           placeholder="Enter contact person" />
                </div>

                <div class="form-group">
                    <label asp-for="City">State</label>
                    <input asp-for="City"
                           class="modern-form-input"
                           placeholder="Enter state" />
                </div>

                <div class="form-group">
                    <label asp-for="Phone">Phone Number</label>
                    <input asp-for="Phone"
                           class="modern-form-input"
                           placeholder="Enter phone number"
                           type="tel" />
                </div>

                <div class="form-group full-width">
                    <label asp-for="GSTIN">GSTIN</label>
                    <input asp-for="GSTIN"
                           class="modern-form-input"
                           placeholder="Enter GSTIN (optional)" />
                </div>

                <div class="form-group full-width">
                    <label asp-for="Address">Address</label>
                    <textarea asp-for="Address"
                              class="modern-form-input"
                              rows="4"
                              placeholder="Enter complete address"></textarea>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="modern-primary-btn">
                    Update Customer
                </button>

                <a asp-action="Index" class="modern-secondary-btn">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
