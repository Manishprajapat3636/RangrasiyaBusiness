
@model IEnumerable<RangrasiyaBusiness.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
    var invoices = Model.ToList();
    var totalAmount = invoices.Sum(i => i.GrandTotal);
    var pendingCount = invoices.Count(i => i.PaymentStatus == "Pending");
    var paidCount = invoices.Count(i => i.PaymentStatus == "Paid");
    var currentSortBy = (ViewBag.SortBy as string) ?? "date";
    var currentSortOrder = (ViewBag.SortOrder as string) ?? "desc";
}


<style>
    .invoice-page .btn, .invoice-page button, .invoice-page a.action-btn, .invoice-page .btn-create {
        border: 1px solid currentColor;
        border-radius: 8px;
        font-weight: 600;
        transition: box-shadow .15s ease, filter .15s ease;
    }
    .invoice-page .btn:hover, .invoice-page button:hover, .invoice-page a.action-btn:hover, .invoice-page .btn-create:hover {
        box-shadow: 0 3px 10px rgba(15,40,75,.14);
        filter: brightness(.97);
    }
    .customer-info { align-items:flex-start; }
    .customer-info .customer-name-block { min-width:0; max-width:260px; white-space:normal; overflow-wrap:anywhere; }
    .customer-info .customer-name-block strong, .customer-info .customer-name-block small { display:block; white-space:normal; overflow-wrap:anywhere; line-height:1.4; }
    .customer-info .customer-name-block small { color:#64748b; margin-top:3px; }
    .invoice-table th, .invoice-table td { border-bottom:1px solid #dce4ef; }
</style>

<div class="invoice-page">

    <!-- Header -->
    <div class="page-header">

        <div>
            <span class="page-eyebrow">FINANCE MANAGEMENT</span>
            <h1>Invoices</h1>
            <p>Manage invoices, payments, and billing records.</p>
        </div>

        <a asp-action="Create" class="btn-create">
            <span>＋</span> Create Invoice
        </a>

    </div>

    <!-- Summary Cards -->
    <div class="invoice-summary">

        <div class="invoice-summary-card">
            <div class="summary-icon blue">▤</div>
            <div>
                <span>Total Invoices</span>
                <h2>@invoices.Count</h2>
                <small>All billing records</small>
            </div>
        </div>

        <div class="invoice-summary-card">
            <div class="summary-icon green">₹</div>
            <div>
                <span>Total Amount</span>
                <h2>₹@totalAmount.ToString("N0")</h2>
                <small>Invoice grand total</small>
            </div>
        </div>

        <div class="invoice-summary-card">
            <div class="summary-icon orange">◷</div>
            <div>
                <span>Pending Payments</span>
                <h2>@pendingCount</h2>
                <small>Awaiting payment</small>
            </div>
        </div>

        <div class="invoice-summary-card">
            <div class="summary-icon purple">✓</div>
            <div>
                <span>Paid Invoices</span>
                <h2>@paidCount</h2>
                <small>Payment completed</small>
            </div>
        </div>

    </div>

    <!-- Main Panel -->
    <div class="invoice-panel">

        <div class="panel-header">
            <div>
                <h2>Invoice List</h2>
                <p>View and manage your invoices.</p>
            </div>

            <span class="record-count">
                @invoices.Count Records
            </span>
        </div>

        <!-- Search and sorting -->
        <div class="invoice-tools">

            <form asp-action="Index" method="get" class="sort-form">
                <label for="sortBy">Sort by</label>
                <select id="sortBy" name="sortBy" class="filter-select" onchange="this.form.submit()">
                     <option value="number" selected="@(currentSortBy == "number")">Invoice Number</option>
                    <option value="date" selected="@(currentSortBy == "date")">Invoice Date</option>
                    <option value="amount" selected="@(currentSortBy == "amount")">Amount</option>
                    <option value="customer" selected="@(currentSortBy == "customer")">Customer Name</option>
                    <option value="status" selected="@(currentSortBy == "status")">Payment Status</option>
                </select>

                <label for="order">Order</label>
                <select id="order" name="order" class="filter-select" onchange="this.form.submit()">
                    <option value="asc" selected="@(currentSortOrder == "asc")">Ascending</option>
                    <option value="desc" selected="@(currentSortOrder == "desc")">Descending</option>
                </select>
            </form>

            <div class="search-box">
                <span>⌕</span>
                <input type="text"
                       id="invoiceSearch"
                       placeholder="Search invoice number or customer..." />
            </div>

            <select id="statusFilter" class="filter-select">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
                <option value="Partial">Partial</option>
            </select>

        </div>

        <!-- Table -->
        <div class="table-container">

            <table class="invoice-table" id="invoiceTable">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Invoice Details</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Grand Total</th>
                        <th>Payment Status</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int serialNumber = 1;
                    }

                    @foreach (var invoice in invoices)
                    {
                        var statusClass = invoice.PaymentStatus?.ToLower() switch
                        {
                            "paid" => "status-paid",
                            "partial" => "status-partial",
                            _ => "status-pending"
                        };

                        <tr class="invoice-row"
                            data-search="@($"{invoice.InvoiceNumber} {invoice.Customer?.CustomerName} {invoice.Customer?.ContactPerson} {invoice.Customer?.Phone}")"
                            data-status="@invoice.PaymentStatus">

                            <td class="serial-number">
                                @serialNumber
                            </td>

                            <td>
                                <div class="invoice-number">
                                    <span class="invoice-icon">▤</span>
                                    <div>
                                        <strong>@invoice.InvoiceNumber</strong>
                                        <small>Invoice</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="date-info">
                                    <strong>
                                        @invoice.InvoiceDate.ToString("dd MMM yyyy")
                                    </strong>
                                    <small>
                                        @invoice.InvoiceDate.ToString("ddd")
                                    </small>
                                </div>
                            </td>

                            <td>
                                <div class="customer-info">
                                    <span class="customer-avatar">
                                        @(invoice.Customer?.CustomerName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                    </span>
                                    <div class="customer-name-block">
                                        <strong>@(invoice.Customer?.CustomerName ?? "Unknown Customer")</strong>
                                        <small>Contact: @(string.IsNullOrWhiteSpace(invoice.Customer?.ContactPerson) ? "Not specified" : invoice.Customer.ContactPerson)</small>
                                        @if (!string.IsNullOrWhiteSpace(invoice.Customer?.Phone))
                                        {
                                            <small>Phone: @invoice.Customer.Phone</small>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                <strong class="amount">
                                    ₹@invoice.GrandTotal.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                <span class="payment-status @statusClass">
                                    @invoice.PaymentStatus
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="action-btn details-btn"
                                       title="View Details">
                                        View
                                    </a>

                                    <a asp-action="DownloadPdf"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="action-btn pdf-btn"
                                       title="Download PDF">
                                        PDF
                                    </a>

                                    <a asp-action="ExportExcel"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="action-btn pdf-btn"
                                       title="Download this invoice as Excel">
                                        Excel
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="action-btn edit-btn"
                                       title="Edit Invoice">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="action-btn delete-btn"
                                       title="Delete Invoice">
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>

                        serialNumber++;
                    }

                    @if (!invoices.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon">▤</div>
                                    <h3>No Invoices Found</h3>
                                    <p>Create your first invoice to get started.</p>

                                    <a asp-action="Create" class="btn-create">
                                        ＋ Create Invoice
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

            <div id="noResults" class="no-results" style="display:none;">
                No matching invoices found.
            </div>

        </div>

    </div>

</div>

<style>

    .invoice-page {
        padding: 35px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-eyebrow {
        color: #1769e0;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: 7px 0;
        color: #172b4d;
        font-size: 32px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: #718096;
        font-size: 14px;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #1769e0;
        color: white !important;
        text-decoration: none;
        border-radius: 9px;
        padding: 13px 20px;
        font-size: 13px;
        font-weight: 700;
        border: none;
        transition: 0.2s;
    }

    .btn-create:hover {
        background: #0d56bd;
        transform: translateY(-1px);
    }

    .btn-create span {
        font-size: 18px;
    }

    .invoice-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .invoice-summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(20, 50, 90, 0.04);
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 23px;
        font-weight: 800;
    }

    .summary-icon.blue {
        background: #e8f1ff;
        color: #1769e0;
    }

    .summary-icon.green {
        background: #e5f8ed;
        color: #16834b;
    }

    .summary-icon.orange {
        background: #fff3dc;
        color: #c17a00;
    }

    .summary-icon.purple {
        background: #f0eaff;
        color: #7351c8;
    }

    .invoice-summary-card span {
        color: #718096;
        font-size: 12px;
    }

    .invoice-summary-card h2 {
        margin: 5px 0;
        color: #172b4d;
        font-size: 23px;
        font-weight: 800;
    }

    .invoice-summary-card small {
        color: #9aa6b5;
        font-size: 11px;
    }

    .invoice-panel {
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 17px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(20, 50, 90, 0.05);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

    .panel-header h2 {
        margin: 0 0 5px;
        color: #243b53;
        font-size: 21px;
    }

    .panel-header p {
        margin: 0;
        color: #8a98aa;
        font-size: 13px;
    }

    .record-count {
        padding: 8px 13px;
        background: #edf4ff;
        color: #1769e0;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .invoice-tools {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }

    .sort-form {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sort-form label {
        color: #52657c;
        font-size: 12px;
        font-weight: 700;
    }

    .sort-form .filter-select {
        min-height: 42px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        max-width: 450px;
        border: 1px solid #dce4ef;
        border-radius: 9px;
        padding: 0 13px;
        background: #fbfcfe;
    }

    .search-box span {
        color: #8292a8;
        font-size: 22px;
    }

    .search-box input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        padding: 12px 0;
        color: #334155;
        font-size: 13px;
    }

    .filter-select {
        border: 1px solid #dce4ef;
        border-radius: 9px;
        padding: 0 13px;
        color: #52657c;
        background: white;
        font-size: 13px;
        outline: none;
    }

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .invoice-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

    .invoice-table thead th {
        background: #f3f6fb;
        color: #63758b;
        padding: 15px 13px;
        text-align: left;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.3px;
        white-space: nowrap;
        border-bottom: 1px solid #e4eaf2;
    }

    .invoice-table tbody td {
        padding: 17px 13px;
        border-bottom: 1px solid #edf1f6;
        color: #52657c;
        font-size: 13px;
        vertical-align: middle;
    }

    .invoice-table tbody tr:hover {
        background: #f9fbff;
    }

    .serial-number {
        color: #9aa6b5 !important;
        font-weight: 700;
    }

    .invoice-number,
    .customer-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .invoice-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #eaf2ff;
        color: #1769e0;
        font-size: 17px;
    }

    .invoice-number strong,
    .customer-info strong {
        display: block;
        color: #263f5d;
        font-size: 12px;
        white-space: nowrap;
    }

    .invoice-number small,
    .date-info small {
        display: block;
        color: #9aa6b5;
        font-size: 11px;
        margin-top: 4px;
    }

    .date-info strong {
        color: #52657c;
        font-size: 12px;
        white-space: nowrap;
    }

    .customer-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e8f1ff;
        color: #1769e0;
        font-weight: 800;
        font-size: 12px;
    }

    .amount {
        color: #1769e0;
        font-size: 13px;
        white-space: nowrap;
    }

    .payment-status {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff3d9;
        color: #b77900;
    }

    .status-paid {
        background: #e4f8ec;
        color: #16834b;
    }

    .status-partial {
        background: #e9efff;
        color: #4264bd;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn {
        padding: 8px 10px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: 0.2s;
        white-space: nowrap;
    }

    .details-btn {
        background: #e1f2ff;
        color: #1475b8;
    }

    .pdf-btn {
        background: #e4f7eb;
        color: #16834b;
    }

    .edit-btn {
        background: #e9efff;
        color: #1769e0;
    }

    .delete-btn {
        background: #fff0f1;
        color: #dc3545;
    }

    .action-btn:hover {
        transform: translateY(-1px);
        opacity: 0.8;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 38px;
        color: #1769e0;
        margin-bottom: 12px;
    }

    .empty-state h3 {
        color: #243b53;
        margin: 0 0 8px;
    }

    .empty-state p {
        color: #8a98aa;
        margin-bottom: 20px;
    }

    .no-results {
        padding: 35px;
        text-align: center;
        color: #8a98aa;
        font-size: 14px;
    }

    @@media (max-width: 1200px) {

        .invoice-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

    @@media (max-width: 768px) {

        .invoice-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .invoice-summary {
            grid-template-columns: 1fr;
        }

        .invoice-tools {
            flex-direction: column;
        }

        .search-box {
            max-width: 100%;
        }

        .filter-select {
            min-height: 42px;
        }

        .invoice-panel {
            padding: 15px;
        }

        .panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>

<script>

    const searchInput = document.getElementById("invoiceSearch");
    const statusFilter = document.getElementById("statusFilter");
    const rows = document.querySelectorAll(".invoice-row");
    const noResults = document.getElementById("noResults");

    function filterInvoices() {

        const searchText = searchInput.value.toLowerCase().trim();
        const selectedStatus = statusFilter.value.toLowerCase();

        let visibleCount = 0;

        rows.forEach(row => {

            const searchData = row.dataset.search.toLowerCase();
            const status = row.dataset.status.toLowerCase();

            const matchesSearch = searchData.includes(searchText);
            const matchesStatus =
                selectedStatus === "" || status === selectedStatus;

            if (matchesSearch && matchesStatus) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }

        });

        noResults.style.display =
            visibleCount === 0 ? "block" : "none";

    }

    searchInput.addEventListener("input", filterInvoices);
    statusFilter.addEventListener("change", filterInvoices);

</script>
