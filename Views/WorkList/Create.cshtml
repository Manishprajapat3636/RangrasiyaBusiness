@model RangrasiyaBusiness.Models.WorkList

@{
    ViewData["Title"] = "Create Work List";
}

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">WORK MANAGEMENT</div>
            <h2>Create New Work List</h2>
            <p>Work order, site information and measurements</p>
        </div>
        <a asp-action="Index" class="modern-clear-btn">← Back</a>
    </div>

    <div class="modern-panel customer-form-card">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-section-title">
                <h4>Work Order Information</h4>
                <p>Enter the work order and customer details.</p>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="WorkOrderNo">Work Order No. *</label>
                    <input asp-for="WorkOrderNo" class="modern-form-input"
                           placeholder="Enter work order number" />
                    <span asp-validation-for="WorkOrderNo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="QuotationNo">Quotation No.</label>
                    <input asp-for="QuotationNo" class="modern-form-input"
                           placeholder="Enter quotation number" />
                </div>

                <div class="form-group">
                    <label asp-for="BillNo">Bill No.</label>
                    <input asp-for="BillNo" class="modern-form-input"
                           placeholder="Enter bill number" />
                </div>

                <div class="form-group">
                    <label asp-for="CustomerId">Customer *</label>
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="modern-form-input">
                        <option value="0">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="OfficerName">Officer Name</label>
                    <input asp-for="OfficerName" class="modern-form-input"
                           placeholder="Enter officer name" />
                </div>

                <div class="form-group">
                    <label asp-for="OfficerContact">Officer Contact</label>
                    <input asp-for="OfficerContact" class="modern-form-input"
                           placeholder="Enter contact number" />
                </div>

                <div class="form-group">
                    <label asp-for="WorkType">Work Type</label>
                    <input asp-for="WorkType" class="modern-form-input"
                           placeholder="Enter work type" />
                </div>

                <div class="form-group">
                    <label asp-for="Department">Department</label>
                    <input asp-for="Department" class="modern-form-input"
                           placeholder="Enter department" />
                </div>

                <div class="form-group">
                    <label asp-for="FromDate">From Date</label>
                    <input asp-for="FromDate" type="date"
                           class="modern-form-input" />
                </div>

                <div class="form-group">
                    <label asp-for="ToDate">To Date</label>
                    <input asp-for="ToDate" type="date"
                           class="modern-form-input" />
                </div>

                <div class="form-group full-width">
                    <label asp-for="WorkSiteAddress">Work Site / Address</label>
                    <textarea asp-for="WorkSiteAddress"
                              class="modern-form-input" rows="2"
                              placeholder="Enter complete work site address"></textarea>
                </div>

            </div>

            <div class="form-section-title" style="margin-top:30px;">
                <h4>Work Measurements</h4>
                <p>Add one row for each measured work item.</p>
            </div>

            <div style="overflow-x:auto;">
                <table class="table" id="measurementTable">
                    <thead>
                        <tr>
                            <th>S. No.</th>
                            <th>Work Description</th>
                            <th>Work Location</th>
                            <th>Unit</th>
                            <th>Length (FEET)</th>
                            <th>Width (FEET)</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="measurementTableBody">
                        <tr class="measurement-row">
                            <td class="row-number">1</td>
                            <td>
                                <input name="measurements[0].Description"
                                       class="modern-form-input"
                                       placeholder="Description" />
                            </td>
                            <td>
                                <input name="measurements[0].Location"
                                       class="modern-form-input"
                                       placeholder="Location" />
                            </td>
                            <td>
                                <select name="measurements[0].Unit"
                                        class="modern-form-input unit-input">
                                    <option value="Sq.Ft">Sq.Ft</option>
                                    <option value="Sq.M">Sq.M</option>
                                    <option value="Running Ft">Running Ft</option>
                                    <option value="Running M">Running M</option>
                                    <option value="Nos">Nos</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Litre">Litre</option>
                                    <option value="Other">Other</option>
                                </select>
                            </td>
                            <td>
                                <input name="measurements[0].Length"
                                       type="number" min="0" step="0.01"
                                       class="modern-form-input length-input"
                                       placeholder="0" />
                            </td>
                            <td>
                                <input name="measurements[0].Width"
                                       type="number" min="0" step="0.01"
                                       class="modern-form-input width-input"
                                       placeholder="0" />
                            </td>
                            <td>
                                <input name="measurements[0].Quantity"
                                       type="number" min="0.01" step="0.01"
                                       value="1"
                                       class="modern-form-input quantity-input"
                                       placeholder="1" />
                            </td>
                            <td>
                                <input name="measurements[0].Total"
                                       type="number" step="0.01"
                                       class="modern-form-input total-input"
                                       readonly />
                            </td>
                            <td>
                                <button type="button"
                                        class="modern-clear-btn"
                                        onclick="removeMeasurementRow(this)">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="7" style="text-align:right;">
                                Grand Total
                            </th>
                            <th>
                                <span id="grandTotal">0.00</span>
                            </th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <button type="button"
                    class="modern-secondary-btn"
                    onclick="addMeasurementRow()"
                    style="margin-top:12px;">
                + Add Measurement Row
            </button>

            <div class="form-actions" style="margin-top:30px;">
                <button type="submit" class="modern-primary-btn">
                    Save Work List
                </button>
                <a asp-action="Index" class="modern-secondary-btn">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let measurementRowIndex = 1;

        function addMeasurementRow() {
            const tbody = document.getElementById("measurementTableBody");
            const i = measurementRowIndex++;

            const row = document.createElement("tr");
            row.className = "measurement-row";

            row.innerHTML = `
                <td class="row-number"></td>
                <td>
                    <input name="measurements[${i}].Description"
                           class="modern-form-input" placeholder="Description" />
                </td>
                <td>
                    <input name="measurements[${i}].Location"
                           class="modern-form-input" placeholder="Location" />
                </td>
                <td>
                    <select name="measurements[${i}].Unit"
                            class="modern-form-input unit-input">
                        <option value="Sq.Ft">Sq.Ft</option>
                        <option value="Sq.M">Sq.M</option>
                        <option value="Running Ft">Running Ft</option>
                        <option value="Running M">Running M</option>
                        <option value="Nos">Nos</option>
                        <option value="Kg">Kg</option>
                        <option value="Litre">Litre</option>
                        <option value="Other">Other</option>
                    </select>
                </td>
                <td>
                    <input name="measurements[${i}].Length"
                           type="number" min="0" step="0.01"
                           class="modern-form-input length-input" placeholder="0" />
                </td>
                <td>
                    <input name="measurements[${i}].Width"
                           type="number" min="0" step="0.01"
                           class="modern-form-input width-input" placeholder="0" />
                </td>
                <td>
                    <input name="measurements[${i}].Quantity"
                           type="number" min="0.01" step="0.01"
                           value="1"
                           class="modern-form-input quantity-input" placeholder="1" />
                </td>
                <td>
                    <input name="measurements[${i}].Total"
                           type="number" step="0.01"
                           class="modern-form-input total-input" readonly />
                </td>
                <td>
                    <button type="button" class="modern-clear-btn"
                            onclick="removeMeasurementRow(this)">Remove</button>
                </td>`;

            tbody.appendChild(row);
            updateRowNumbers();
        }

        function removeMeasurementRow(button) {
            button.closest("tr").remove();
            updateRowNumbers();
            recalculateGrandTotal();
        }

        // Keep row indexes continuous so ASP.NET Core binds every measurement.
        function updateRowNumbers() {
            const rows = document.querySelectorAll(
                "#measurementTableBody .measurement-row"
            );

            rows.forEach((row, index) => {
                const numberCell = row.querySelector(".row-number");
                if (numberCell) numberCell.textContent = index + 1;

                row.querySelectorAll("input[name], select[name], textarea[name]")
                    .forEach(element => {
                        element.name = element.name.replace(
                            /measurements\[\d+\]/i,
                            `measurements[${index}]`
                        );
                    });
            });
        }

        function calculateRow(row) {
            const unit = row.querySelector(".unit-input").value;
            const length = parseFloat(row.querySelector(".length-input").value) || 0;
            const width = parseFloat(row.querySelector(".width-input").value) || 0;
            const quantityInput = row.querySelector(".quantity-input");
            const quantity = Math.max(parseFloat(quantityInput.value) || 1, 0);

            const isArea = unit === "Sq.Ft" || unit === "Sq.M";
            const total = (isArea ? length * width : length) * quantity;

            row.querySelector(".total-input").value = total.toFixed(2);
            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let total = 0;

            document.querySelectorAll("#measurementTableBody .total-input")
                .forEach(input => {
                    total += parseFloat(input.value) || 0;
                });

            document.getElementById("grandTotal").textContent = total.toFixed(2);
        }

        // Reindex one final time before submission, even if rows were removed.
        const workListForm = document.getElementById("measurementTable").closest("form");
        workListForm.addEventListener("submit", function () {
            updateRowNumbers();
        });

        document.getElementById("measurementTableBody")
            .addEventListener("input", function (event) {
                if (event.target.matches(".length-input, .width-input, .quantity-input")) {
                    calculateRow(event.target.closest("tr"));
                }
            });

        document.getElementById("measurementTableBody")
            .addEventListener("change", function (event) {
                if (event.target.matches(".unit-input")) {
                    calculateRow(event.target.closest("tr"));
                }
            });

        // Calculate the first row on page load.
        document.querySelectorAll("#measurementTableBody .measurement-row")
            .forEach(calculateRow);
    </script>
}
