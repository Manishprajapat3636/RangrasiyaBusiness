
@model RangrasiyaBusiness.Models.Work

@{
    ViewData["Title"] = "Delete Work";
}

<div class="customer-form-page">

    <div class="page-heading">
        <div>
            <div class="page-eyebrow">WORKS & PROJECTS</div>
            <h2>Delete Work</h2>
            <p>Review the project before deleting it</p>
        </div>

        <a asp-action="Index" class="modern-clear-btn">
            ← Back
        </a>
    </div>

    <div class="modern-panel delete-confirmation-card">

        <div class="delete-warning-icon">⚠️</div>

        <h3>Are you sure you want to delete this work?</h3>

        <p class="delete-warning-text">
            This action may permanently remove the project record.
            Please verify the details before continuing.
        </p>

        <div class="delete-details-grid">

            <div class="detail-info-item">
                <span>Work Name</span>
                <strong>@Model.WorkName</strong>
            </div>

            <div class="detail-info-item">
                <span>Customer</span>
                <strong>
                    @(Model.Customer?.CustomerName ?? "N/A")
                </strong>
            </div>

            <div class="detail-info-item">
                <span>Work Location</span>
                <strong>
                    @(Model.WorkLocation ?? "Not Set")
                </strong>
            </div>

            <div class="detail-info-item">
                <span>Status</span>
                <strong>
                    @(Model.Status ?? "Not Set")
                </strong>
            </div>

            <div class="detail-info-item">
                <span>Estimated Amount</span>
                <strong>
                    ₹@Model.EstimatedAmount.ToString("N2")
                </strong>
            </div>

            <div class="detail-info-item">
                <span>Actual Amount</span>
                <strong>
                    ₹@Model.ActualAmount.ToString("N2")
                </strong>
            </div>

        </div>

        <form asp-action="Delete" method="post" class="delete-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="WorkId" />

            <button type="submit"
                    class="delete-confirm-btn">
                Delete Permanently
            </button>

            <a asp-action="Index"
               class="modern-secondary-btn">
                Cancel
            </a>

        </form>

    </div>

</div>
