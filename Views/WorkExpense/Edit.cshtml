
@model RangrasiyaBusiness.Models.WorkExpense

@{
    ViewData["Title"] = "Edit Work Expense";
}

<div class="form-page">

    <div class="page-heading">
        <div>
            <span class="page-eyebrow">EXPENSE MANAGEMENT</span>
            <h2>Edit Work Expense</h2>
            <p>Update your project expense details.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back
        </a>
    </div>

    <div class="modern-panel form-panel">

        <div class="table-heading">
            <div>
                <h5>Expense Information</h5>
                <small class="text-muted">
                    Modify the details below and save your changes.
                </small>
            </div>
        </div>

        <div class="p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="WorkExpenseId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="WorkId" class="form-label">
                            Work / Project
                        </label>

                        <select asp-for="WorkId"
                                asp-items="ViewBag.WorkId"
                                class="form-select">
                            <option value="">-- Select Work --</option>
                        </select>

                        <span asp-validation-for="WorkId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpenseType" class="form-label">
                            Expense Type
                        </label>

                        <select asp-for="ExpenseType"
                                asp-items="ViewBag.ExpenseTypes"
                                class="form-select">
                            <option value="">-- Select Expense Type --</option>
                        </select>

                        <span asp-validation-for="ExpenseType"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Description" class="form-label">
                            Description
                        </label>

                        <input asp-for="Description"
                               class="form-control"
                               placeholder="Enter expense description" />

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">
                            Amount (₹)
                        </label>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="Enter amount" />

                        <span asp-validation-for="Amount"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpenseDate" class="form-label">
                            Expense Date
                        </label>

                        <input asp-for="ExpenseDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ExpenseDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Notes" class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Add additional notes (optional)"></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="form-actions mt-4">

                    <button type="submit"
                            class="modern-primary-btn">
                        Update Expense
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
